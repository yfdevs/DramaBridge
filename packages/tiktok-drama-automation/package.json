{
  "name": "@dramabridge/tiktok-drama-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm --filter @dramabridge/feishu-notifier build && vp pack",
    "check": "tsc --noEmit",
    "install:browser": "playwright install chromium",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@dramabridge/automation-logging": "workspace:*",
    "@dramabridge/feishu-notifier": "workspace:*",
    "playwright": "1.61.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "7.0.2",
    "vite": "catalog:"
  }
}
