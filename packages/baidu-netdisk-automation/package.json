{
  "name": "@dramabridge/baidu-netdisk-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./download-baidu-folder": {
      "types": "./src/download-baidu-folder.ts",
      "development": "./src/download-baidu-folder.ts",
      "default": "./dist/download-baidu-folder.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsc --noEmit",
    "test": "tsx --conditions=development --test tests/**/*.test.ts",
    "download:share": "node --experimental-strip-types src/download-baidu-folder.ts"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vite": "catalog:"
  },
  "dependencies": {
    "@dramabridge/automation-logging": "workspace:*",
    "@dramabridge/file-utils": "workspace:*",
    "effect": "3.22.1",
    "execa": "9.6.1",
    "ws": "^8.21.0"
  }
}
