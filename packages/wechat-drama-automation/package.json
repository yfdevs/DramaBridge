{
  "name": "@dramabridge/wechat-drama-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm --filter @dramabridge/axios build && vp pack",
    "check": "tsc --noEmit",
    "test": "tsx --conditions=development --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@dramabridge/axios": "workspace:*",
    "@dramabridge/automation-logging": "workspace:*",
    "@dramabridge/browser-window": "workspace:*",
    "@dramabridge/file-utils": "workspace:*",
    "@dramabridge/media-assets": "workspace:*",
    "p-queue": "^9.3.3",
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "7.0.2",
    "vite": "catalog:"
  }
}
