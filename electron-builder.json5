{
  $schema: "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  appId: "com.yfdevs.dramabridge",
  asar: true,
  asarUnpack: [
    "node_modules/better-sqlite3/**/*.node",
    "node_modules/ffmpeg-static/**/*",
    "node_modules/ffprobe-static/**/*",
    "node_modules/@ffprobe-installer/**/*",
    "node_modules/sharp/**/*",
    "node_modules/is-url/**/*",
    "node_modules/node-fetch/**/*",
    "node_modules/regenerator-runtime/**/*",
    "node_modules/tr46/**/*",
    "node_modules/wasm-feature-detect/**/*",
    "node_modules/webidl-conversions/**/*",
    "node_modules/whatwg-url/**/*",
    "node_modules/@img/**/*",
  ],
  npmRebuild: false,
  nodeGypRebuild: false,
  buildDependenciesFromSource: false,
  productName: "DramaBridge",
  directories: {
    output: "release/${version}",
    buildResources: "build",
  },
  files: ["dist", "dist-electron"],
  extraResources: [
    {
      from: "packages/youtube-automation/python",
      to: "youtube-automation",
      filter: ["**/*", "!**/__pycache__/**", "!**/*.pyc"],
    },
    {
      from: ".cache/playwright-browsers",
      to: "playwright-browsers",
      filter: ["**/*", "!winldd-*", "!winldd-*/**"],
    },
  ],
  mac: {
    target: [
      { target: "dmg", arch: ["arm64"] },
      { target: "zip", arch: ["arm64"] },
    ],
    icon: "build/icons/icon.icns",
    artifactName: "${productName}-Mac-${version}-${arch}.${ext}",
    // Local/CI builds need no Apple credentials. Developer ID signing and
    // notarization can be enabled through explicit release configuration.
    identity: "-",
    hardenedRuntime: false,
    notarize: false,
  },
  win: {
    target: [
      {
        target: "nsis",
        arch: ["x64"],
      },
    ],
    icon: "build/icons/icon.ico",
    artifactName: "${productName}-Windows-${version}-Setup.${ext}",
    publish: [
      {
        provider: "generic",
        url: "https://down.mxw.xx.kg/https://github.com/yfdevs/DramaBridge/releases/latest/download",
        channel: "latest",
      },
      {
        provider: "github",
        owner: "yfdevs",
        repo: "DramaBridge",
        releaseType: "release",
      },
    ],
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  linux: {
    target: ["AppImage"],
    icon: "build/icons",
    artifactName: "${productName}-Linux-${version}.${ext}",
  },
}
